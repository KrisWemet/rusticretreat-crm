# ── Server ────────────────────────────────────────────────────────────────
PORT=3001
# Public URL of the client app (used in emails + Stripe redirect URLs)
BASE_URL=http://localhost:5173
# Optional: set a fixed JWT secret (otherwise one is generated and persisted)
# JWT_SECRET=

# ── Email (nodemailer) ──────────────────────────────────────────────────────
# Leave blank to run in no-op mode — emails are logged to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Rustic Retreat <noreply@rusticretreat.com>
# Where staff notifications (new leads, accepted proposals, etc.) are sent.
ADMIN_EMAIL=

# ── Stripe (online card payments) ───────────────────────────────────────────
# Leave blank to disable card payments — the portal falls back to e-Transfer.
# Get your keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret — two setup options:
#
# OPTION A — Local development (Stripe CLI):
#   1. Install: https://stripe.com/docs/stripe-cli
#   2. Run:    stripe listen --forward-to localhost:3001/api/payments/webhook
#   3. Copy the "whsec_..." secret it prints into STRIPE_WEBHOOK_SECRET
#
# OPTION B — Production (or any public URL):
#   1. Run:  node setup-stripe-webhook.js https://your-domain.com
#   2. The script creates the webhook and updates .env automatically.
#
#   Or create manually in the dashboard: https://dashboard.stripe.com/webhooks
#   Event to enable: checkout.session.completed
#   Webhook URL:     https://your-domain.com/api/payments/webhook
#
# Without this set, webhook events are processed without signature verification
# (fine for testing, must be set in production).
STRIPE_WEBHOOK_SECRET=
