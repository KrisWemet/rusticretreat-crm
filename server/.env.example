# ── Server ────────────────────────────────────────────────────────────────
PORT=3001
# Public URL of the client app (used in emails + Stripe redirect URLs)
BASE_URL=http://localhost:5173
# Optional: set a fixed JWT secret (otherwise one is generated and persisted)
# JWT_SECRET=

# ── Email ───────────────────────────────────────────────────────────────────
# Contract signing links are emailed to each partner separately, so email must
# work for the e-signature flow to function at all.
#
# OPTION A (recommended) — Resend over HTTPS. Works on any host, including ones
# that block outbound SMTP ports. Create a sending key at
# https://resend.com/api-keys and set SMTP_FROM to an address on a domain you
# have verified in Resend.
RESEND_API_KEY=
# Only override if you route Resend through a proxy.
# RESEND_API_URL=https://api.resend.com/emails

# OPTION B — your own SMTP server. Used only when RESEND_API_KEY is unset.
# Leave both blank to run in no-op mode — emails are logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must be an address on a domain verified with your email provider.
SMTP_FROM=Rustic Retreat <noreply@rusticretreatalberta.ca>
# Where staff notifications (new leads, accepted proposals, etc.) are sent.
ADMIN_EMAIL=

# ── Backups ─────────────────────────────────────────────────────────────────
# The database is snapshotted into backups/ beside it (so onto your volume).
# BACKUP_INTERVAL_HOURS=24   # 0 disables the scheduler
# BACKUP_KEEP=14             # how many snapshots to retain
# BACKUP_DIR=/data/backups   # defaults to a backups/ folder next to DB_PATH

# ── Couple portal ───────────────────────────────────────────────────────────
# The couple-facing portal is not in use yet. While this is unset, signing a
# contract does NOT create portal logins and the confirmation email leaves out
# the portal link. Set to 1 when the portal is ready.
# ENABLE_COUPLE_PORTAL=1

# ── Stripe (online card payments) ───────────────────────────────────────────
# Leave blank to disable card payments — the portal falls back to e-Transfer.
# Get your keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret — two setup options:
#
# OPTION A — Local development (Stripe CLI):
#   1. Install: https://stripe.com/docs/stripe-cli
#   2. Run:    stripe listen --forward-to localhost:3001/api/payments/webhook
#   3. Copy the "whsec_..." secret it prints into STRIPE_WEBHOOK_SECRET
#
# OPTION B — Production (or any public URL):
#   1. Run:  node setup-stripe-webhook.js https://your-domain.com
#   2. The script creates the webhook and updates .env automatically.
#
#   Or create manually in the dashboard: https://dashboard.stripe.com/webhooks
#   Event to enable: checkout.session.completed
#   Webhook URL:     https://your-domain.com/api/payments/webhook
#
# Without this set, webhook events are processed without signature verification
# (fine for testing, must be set in production).
STRIPE_WEBHOOK_SECRET=
